<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sderosiaux.launchdeck.fake</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sleep</string>
    <string>3600</string>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/launchdeck-fake.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/launchdeck-fake.err.log</string>
</dict>
</plist>
